# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o git (RNF01).
OPENAI_API_KEY=coloque-sua-chave-aqui

# --- Modelos (opcional) ---
MODELO_VISAO=gpt-4.1-mini
MODELO_STT=gpt-4o-mini-transcribe
MODELO_TTS=gpt-4o-mini-tts
VOZ_TTS=alloy
IDIOMA=pt

# --- Câmera ---
# 0 = webcam padrão, 1 = segunda webcam, ou caminho de vídeo/imagem para testes
CAMERA=0
IMAGEM_LADO_MAX=1024

# --- Microfone ---
GRAVACAO_MAX_SEG=15
SILENCIO_SEG=1.3
SEM_FALA_SEG=6

# --- Rede ---
TIMEOUT_REQUISICAO=30
TENTATIVAS_API=2

# --- Voz e registros ---
TTS_ATIVO=true
TTS_OFFLINE_FALLBACK=true
SALVAR_HISTORICO=true
