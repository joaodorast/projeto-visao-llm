# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o git (RNF01).
# Depois de abrir o app, quase tudo também pode ser alterado na página Ajustes.

# --- Provedor de LLM: "gemini" ou "openai" ---
# Para trocar de provedor, mude esta linha e preencha a chave correspondente abaixo.
PROVEDOR=gemini

# Gemini: https://aistudio.google.com/apikey (possui camada gratuita)
GEMINI_API_KEY=coloque-sua-chave-gemini-aqui
# OpenAI: https://platform.openai.com/api-keys (exige créditos)
OPENAI_API_KEY=coloque-sua-chave-openai-aqui

# --- Modelos (opcional: se vazio, usa o padrão do provedor escolhido) ---
# Gemini: gemini-3.8-flash (visão e transcrição) · gemini-3.8-flash-tts · voz Kore
# OpenAI: gpt-4.1-mini · gpt-4o-mini-transcribe · gpt-4o-mini-tts · voz alloy
#MODELO_VISAO=
#MODELO_STT=
#MODELO_TTS=
#VOZ_TTS=
IDIOMA=pt

# --- Câmera ---
# 0 = webcam padrão, 1 = segunda webcam, ou caminho de vídeo/imagem para testes
CAMERA=0
IMAGEM_LADO_MAX=1024

# --- Microfone ---
GRAVACAO_MAX_SEG=15
SILENCIO_SEG=1.3
SEM_FALA_SEG=6

# --- Rede ---
TIMEOUT_REQUISICAO=30
TENTATIVAS_API=2

# --- Voz e registros ---
TTS_ATIVO=true
TTS_OFFLINE_FALLBACK=true
SALVAR_HISTORICO=true
